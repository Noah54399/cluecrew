# ------------------------------------------------------------------
# ClueCrew client configuration
#
# Leave VITE_API_URL empty when the backend serves the built client
# (single-origin deployment - the simplest and most reliable setup).
#
# Set it to the backend origin when the frontend is hosted separately
# (e.g. Netlify frontend + Render backend):
#   VITE_API_URL=https://cluecrew-api.onrender.com
# ------------------------------------------------------------------

VITE_API_URL=
