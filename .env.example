# ------------------------------------------------------------------
# ClueCrew server configuration
# Copy this file to `.env` (repo root) and fill in your values.
# Every variable is optional in development; the defaults below make
# the game fully playable offline with the mock provider.
#
# Deployment-oriented aliases are supported, so platform variables can
# be named the way hosting providers usually expose them:
#   FRONTEND_URL  -> CLIENT_URL
#   BACKEND_URL   -> PUBLIC_URL
#   SESSION_SECRET -> TOKEN_ENCRYPTION_KEY (the app's single symmetric secret)
#   DATABASE_URL  -> DATABASE_PATH (file:/path or plain path; SQLite only for now)
# ------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=3001
# Public URL of the backend (used for OAuth redirects and links)
BACKEND_URL=http://localhost:3001
# Public URL of the frontend. Same value as BACKEND_URL when the backend
# serves the built client (single-origin, recommended).
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins for CORS + CSRF checks
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Database ---
# SQLite file, created automatically. Accepts `DATABASE_URL=file:./data/cluecrew.sqlite`
# as an alias; PostgreSQL URLs are rejected with a clear message (see docs/DEPLOYMENT.md).
DATABASE_PATH=./data/cluecrew.sqlite
# Rooms (and all stored content references) are deleted after this many hours.
ROOM_TTL_HOURS=12
# Sessions expire after this many days.
SESSION_TTL_DAYS=30

# --- Security ---
# Secret used to encrypt OAuth tokens at rest.
# Recommended: 64 hex chars (used directly as the 32-byte AES key).
# Any other non-empty value (e.g. a platform-generated base64 secret such as
# Render's generateValue) is hashed to a stable 32-byte key with SHA-256.
# SESSION_SECRET is accepted as an alias.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production, otherwise a development key is derived (with a warning).
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# --- Game behaviour ---
# Allow the clearly-labelled mock social provider (demo data) for players
# that have not connected TikTok. Keep `true` for local play; production
# deployments that only want real data can set this to `false`.
ALLOW_MOCK_PROVIDER=true
# Max players per room
MAX_PLAYERS_PER_ROOM=12
# Seconds a disconnected host is given before host rights are transferred
HOST_TRANSFER_GRACE_SECONDS=30
# In-memory room cleanup after this many minutes without activity
ROOM_IDLE_TIMEOUT_MINUTES=180
# Optional: exposed as `version` by GET /health
APP_VERSION=1.1.0

# --- TikTok (optional) ---
# Create an app at https://developers.tiktok.com/ and add the
# "Login Kit" + "Display API" products. Scopes used:
#   user.info.basic, video.list
# The redirect URI must be registered exactly as configured here,
# defaulting to {BACKEND_URL}/api/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Override only if your registered redirect URI differs from the default
# TIKTOK_REDIRECT_URI=https://api.example.com/api/auth/tiktok/callback

# --- TikTok Data Portability (activity import, optional) ---
# Only enable AFTER TikTok approved your app for Data Portability AND
# Login Kit. See docs/TIKTOK-DATA-PORTABILITY.md for the full picture:
# liked/saved videos require the ALL-DATA scope (portability.all.*),
# the "activity" scope does NOT include likes/favourites, and data is
# only returned for TikTok users in the EEA/UK.
TIKTOK_DATAPORTABILITY_ENABLED=false
# portability.all.ongoing (default, needed for likes+saves) or
# portability.all.single / portability.activity.ongoing / ...
TIKTOK_DATAPORTABILITY_SCOPE=portability.all.ongoing

# --- Data import behaviour (optional) ---
# Temporary directory for downloaded export ZIPs (deleted right after parsing)
DP_IMPORT_DIR=./data/imports
# How often pending exports are polled server-side (seconds)
DP_POLL_INTERVAL_SECONDS=120
# Hard caps for imported data
DP_MAX_ACTIONS=2000
DP_MAX_DOWNLOAD_MB=100
# Best-effort title/creator/cover enrichment via TikTok's public oEmbed endpoint
TIKTOK_OEMBED_ENRICH=true
DP_OEMBED_LIMIT=60
